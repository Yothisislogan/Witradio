# WIT Radio Environment Variables

# Icecast
# Source password the station runtime (feeder.py -> ezstream, or Liquidsoap
# for wit-next) uses to connect.
# Must match <source-password> in the server's Icecast config. Set it only in
# the server environment; never commit the real value (this repo is public).
WRIT_SOURCE_PASSWORD=
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme

# wit-next playout (docs/live-setup.md, section 6)
# Alert emails after 20 s of silence, a mount off Icecast, a stalled
# program or a low buffer. Without these they are only logged.
WRIT_ALERT_EMAIL_TO=
WRIT_SMTP_HOST=smtp.gmail.com
WRIT_SMTP_PORT=587
WRIT_SMTP_USER=
# For Gmail, an app password (needs 2-Step Verification)
WRIT_SMTP_PASSWORD=
# Only if the sender differs from WRIT_SMTP_USER
# WRIT_SMTP_FROM=
# Optional: text messages through Twilio as well (the number must be
# registered for A2P 10DLC or toll-free first). See mac/alerts.py.
# Alert when fewer hours than this wait in the buffer (default 12)
WRIT_BUFFER_ALERT_HOURS=12
# Staging only: open the classical blocks before the catalog has the hours
# WRIT_FORCE_CLASSICAL=1

# Stream
STREAM_MOUNT=/witradio
STATION_NAME=WIT Radio

# OpenAI / Claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Kokoro
KOKORO_VOICE=am_michael

# YouTube Relay
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=

# Cloudflare
CLOUDFLARE_TUNNEL_NAME=witradio

# Future Listener Messaging
LISTENER_API_KEY=
