# WIT Radio Environment Variables

# Icecast
# Source password the station runtime (feeder.py -> ezstream) uses to connect.
# Must match <source-password> in the server's Icecast config. Set it only in
# the server environment; never commit the real value (this repo is public).
WRIT_SOURCE_PASSWORD=
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme

# Stream
STREAM_MOUNT=/witradio
STATION_NAME=WIT Radio

# OpenAI / Claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Kokoro
KOKORO_VOICE=am_michael

# YouTube Relay
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=

# Cloudflare
CLOUDFLARE_TUNNEL_NAME=witradio

# Future Listener Messaging
LISTENER_API_KEY=
